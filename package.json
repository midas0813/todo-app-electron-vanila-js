{
  "name": "midas",
  "productName": "Midas",
  "version": "1.0.0",
  "description": "A desktop time management app with tasks, pomodoro timer, time tracking, stats and reminders",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.midas",
    "productName": "Midas",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.ico"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    }
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "feather-icons": "^4.29.2"
  }
}
